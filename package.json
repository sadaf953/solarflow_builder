{
  "name": "solarflow-client-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:template": "SF_ENV_DIR=. vite --config template/vite.config.js",
    "build:template": "SF_ENV_DIR=. vite build --config template/vite.config.js",
    "dev:builder": "node scripts/pack-template.mjs && vite --config builder/vite.config.js",
    "build:builder": "node scripts/check-secrets.mjs && node scripts/pack-template.mjs && vite build --config builder/vite.config.js",
    "pack:template": "node scripts/pack-template.mjs",
    "make-client": "node scripts/make-client.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test": "node --test --test-reporter=dot \"tests/**/*.test.mjs\"",
    "lint": "eslint builder scripts tests/builder && eslint -c template/eslint.config.js template"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "fflate": "0.8.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.454.0",
    "pdf-lib": "1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^7.0.2",
    "vite": "^7.3.0"
  }
}

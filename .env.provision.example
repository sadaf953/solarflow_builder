# Agency settings for `npm run provision` and `npm run keepalive`.
# Copy this file to .env.provision (git ignores it) and fill it in once.
# See docs/PROVISIONING.md. Never commit the real file and never put these
# values in a client folder: they control every client's project and site.

# Supabase personal access token of the agency's Supabase account
# (https://supabase.com/dashboard/account/tokens). It starts with sbp_.
SUPABASE_ACCESS_TOKEN=

# Netlify personal access token
# (Netlify → User settings → Applications → Personal access tokens).
NETLIFY_AUTH_TOKEN=
# Optional: the Netlify team to create client sites in
# (Team settings → General → Team details). Empty = your default team.
NETLIFY_ACCOUNT_SLUG=

# The agency's domain for free client addresses: <slug>.<AGENCY_DOMAIN>.
# Falls back to VITE_AGENCY_DOMAIN in .env.local.
AGENCY_DOMAIN=

# Optional: when AGENCY_DOMAIN's DNS is on Cloudflare, provisioning adds each
# client's CNAME record there. Leave both empty when the domain is on Netlify DNS.
# The token needs Zone → DNS → Edit for that zone only.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
